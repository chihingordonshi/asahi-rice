#!/usr/bin/env bash
# The tracked files used from $HOME are symlinks into ~/Projects/asahi-rice, so
# edits already happen directly in this worktree. This job only commits and
# pushes them; copying the links back with rsync would create self-referential
# symlinks. New files must be added to the repository and linked into $HOME
# deliberately.
set -euo pipefail

REPO="$HOME/Projects/asahi-rice"
LOG="$HOME/.local/share/asahi-rice-sync.log"
STAMP="$HOME/.local/share/asahi-rice-sync-last-run"
TODAY=$(date +%F)

exec >> "$LOG" 2>&1
echo "=== $(date -Is) : run start ==="

if [[ -f "$STAMP" ]] && [[ "$(cat "$STAMP")" == "$TODAY" ]]; then
    echo "already ran today ($TODAY), skipping"
    echo "=== $(date -Is) : run end ==="
    exit 0
fi

cd "$REPO"
git add -A

if git diff --cached --quiet; then
    echo "no tracked changes, skipping commit/push"
else
    git commit -m "auto sync $(date +%F)"
    git push origin main
    echo "pushed"
fi

echo "$TODAY" > "$STAMP"
echo "=== $(date -Is) : run end ==="
