#!/usr/bin/env python3
"""Translate a Codex notify JSON argument into an atomic event file."""

from __future__ import annotations

import json
import os
import sys
import tempfile
import time
import uuid
from pathlib import Path


def state_dir() -> Path:
    override = os.environ.get("CODEX_TOUCHBAR_STATE_DIR")
    return Path(override) if override else Path.home() / ".local/state/codex-touchbar"


def main() -> int:
    if len(sys.argv) != 2:
        return 0
    try:
        notification = json.loads(sys.argv[1])
    except (json.JSONDecodeError, TypeError):
        return 0
    if not isinstance(notification, dict) or notification.get("type") != "agent-turn-complete":
        return 0

    received_ns = time.time_ns()
    events_dir = state_dir() / "events"
    try:
        events_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        record = {
            "received_ns": received_ns,
            "type": "agent-turn-complete",
            "thread_id": notification.get("thread-id"),
            "turn_id": notification.get("turn-id"),
        }
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=events_dir, prefix=".event-", delete=False
        ) as temporary:
            json.dump(record, temporary, separators=(",", ":"), sort_keys=True)
            temporary.write("\n")
            temporary.flush()
            os.fsync(temporary.fileno())
            temporary_path = Path(temporary.name)
        event_name = f"{received_ns:020d}-{os.getpid()}-{uuid.uuid4().hex}.event"
        os.replace(temporary_path, events_dir / event_name)
    except OSError:
        # Notification delivery must never make the Codex turn itself fail.
        try:
            temporary_path.unlink(missing_ok=True)
        except (OSError, UnboundLocalError):
            pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
