#!/usr/bin/env bash
set -euo pipefail

# Waypaper updates its config and replaces the active wallpaper process. Ignore
# repeated clicks while that work is in progress, then allow the backend a
# moment to settle before accepting another request.
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
lock_file="$runtime_dir/random-wallpaper-${UID:-$(id -u)}.lock"
stamp_file="$runtime_dir/random-wallpaper-${UID:-$(id -u)}.stamp"
cooldown_ms=1500

exec 9>"$lock_file"
flock --nonblock 9 || exit 0

now_ms=$(date +%s%3N)
last_ms=0
if [[ -r "$stamp_file" ]]; then
    read -r last_ms < "$stamp_file" || last_ms=0
fi

if [[ "$last_ms" =~ ^[0-9]+$ ]] && (( now_ms - last_ms < cooldown_ms )); then
    exit 0
fi

printf '%s\n' "$now_ms" > "$stamp_file"
exec /usr/bin/waypaper --random
