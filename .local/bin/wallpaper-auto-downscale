#!/usr/bin/env bash
# Watches ~/Videos/Wallpapers and converts every video to rawvideo (capped
# at 1080p), in place. Asahi's GPU driver has no hardware h264/hevc decode
# via VAAPI, so mpv/mpvpaper fall back to single-threaded software decode --
# a 3840x2160 h264 clip pegged a full core and still fell behind in real
# time. Software-decoding rawvideo costs essentially zero CPU (it's a
# memcpy), trading disk space for that -- there's plenty of disk here, so
# that's the whole file, every time, rather than only downscaling files
# that are already above 1080p.
#
# rawvideo isn't a valid mp4 stream, so output goes to .mkv; the original
# .mp4/.webm is removed and any path referencing it (e.g. waypaper's
# config.ini `wallpaper =` line) needs updating to the new .mkv name.

set -u

WATCH_DIR="$HOME/Videos/Wallpapers"
LOG_TAG="wallpaper-auto-downscale"

is_rawvideo() {
    local codec
    codec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$1" 2>/dev/null)
    [[ "$codec" == "rawvideo" ]]
}

convert() {
    local src="$1"
    is_rawvideo "$src" && return

    local height
    height=$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 "$src" 2>/dev/null)
    [[ -z "$height" ]] && return

    local scale_filter="scale=-2:1080"
    (( height <= 1080 )) && scale_filter="scale=-2:ih"

    local dst="${src%.*}.mkv"
    local tmp="${dst}.converting.tmp.mkv"
    logger -t "$LOG_TAG" "converting $src -> $dst (rawvideo, capped at 1080p)"

    if ffmpeg -y -i "$src" -vf "$scale_filter" -c:v rawvideo -c:a copy -f matroska "$tmp" \
        >/tmp/wallpaper-auto-downscale.log 2>&1; then
        mv -f "$tmp" "$dst"
        [[ "$src" != "$dst" ]] && rm -f "$src"
        logger -t "$LOG_TAG" "done: $dst"
    else
        logger -t "$LOG_TAG" "ffmpeg failed on $src, see /tmp/wallpaper-auto-downscale.log"
        rm -f "$tmp"
    fi
}

mkdir -p "$WATCH_DIR"

for f in "$WATCH_DIR"/*.mp4 "$WATCH_DIR"/*.mkv "$WATCH_DIR"/*.webm; do
    [[ -f "$f" ]] && convert "$f"
done

inotifywait -m -e close_write -e moved_to --format '%w%f' "$WATCH_DIR" 2>/dev/null |
while read -r path; do
    case "$path" in
        *.converting.tmp.mkv) continue ;;
        *.mp4|*.mkv|*.webm) convert "$path" ;;
    esac
done
