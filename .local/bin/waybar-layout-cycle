#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
instance="${HYPRLAND_INSTANCE_SIGNATURE:-}"

if [[ -z "$instance" || ! -S "$runtime_dir/hypr/$instance/.socket.sock" ]]; then
    for socket in "$runtime_dir"/hypr/*/.socket.sock; do
        [[ -S "$socket" ]] || continue
        instance="$(basename "$(dirname "$socket")")"
        break
    done
fi

if [[ -z "$instance" ]]; then
    notify-send -a Waybar "Layout toggle failed" "No active Hyprland instance was found." 2>/dev/null || true
    exit 1
fi

layout=$(hyprctl -i "$instance" activeworkspace -j 2>/dev/null | jq -r '.tiledLayout // "dwindle"' 2>/dev/null || printf 'dwindle')
fullscreen_mode_file="$runtime_dir/hypr-fullscreen-mode"

if [[ -e "$fullscreen_mode_file" ]]; then
    hyprctl -i "$instance" eval 'ToggleFullscreenMode(); SetActiveWorkspaceLayout("dwindle")' >/dev/null
elif [[ "$layout" == "dwindle" ]]; then
    hyprctl -i "$instance" eval 'SetActiveWorkspaceLayout("master")' >/dev/null
elif [[ "$layout" == "master" ]]; then
    hyprctl -i "$instance" eval 'ToggleFullscreenMode()' >/dev/null
else
    hyprctl -i "$instance" eval 'SetActiveWorkspaceLayout("dwindle")' >/dev/null
fi

pkill -RTMIN+9 -x waybar 2>/dev/null || true
