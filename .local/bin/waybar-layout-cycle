#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
instance="${HYPRLAND_INSTANCE_SIGNATURE:-}"

if [[ -z "$instance" || ! -S "$runtime_dir/hypr/$instance/.socket.sock" ]]; then
    for socket in "$runtime_dir"/hypr/*/.socket.sock; do
        [[ -S "$socket" ]] || continue
        instance="$(basename "$(dirname "$socket")")"
        break
    done
fi

if [[ -z "$instance" ]]; then
    notify-send -a Waybar "Layout toggle failed" "No active Hyprland instance was found." 2>/dev/null || true
    exit 1
fi

layout=$(hyprctl -i "$instance" getoption general:layout -j 2>/dev/null | jq -r '.str // "dwindle"' 2>/dev/null || printf 'dwindle')

case "$layout" in
    dwindle) next=master ;;
    master) next=scrolling ;;
    scrolling) next=monocle ;;
    *) next=dwindle ;;
esac

hyprctl -i "$instance" eval "hl.config({general = {layout = \"$next\"}})" >/dev/null
