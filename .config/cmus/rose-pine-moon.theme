# Rose Pine Moon for cmus.
# Uses Kitty's Rose Pine Moon ANSI palette (0-15), so it stays in sync with
# ~/.config/kitty/current-theme.conf.

# Core interface
set color_win_bg=default
set color_win_fg=7
set color_win_dir=4
set color_separator=8

# Messages and command line
set color_cmdline_bg=0
set color_cmdline_fg=7
set color_error=1
set color_info=4

# Header and now-playing line
set color_win_title_bg=0
set color_win_title_fg=5
set color_titleline_bg=0
set color_titleline_fg=6
set color_win_cur=3
set color_win_cur_attr=bold

# Status and progress bar
set color_statusline_bg=0
set color_statusline_fg=7
set color_statusline_progress_bg=5
set color_statusline_progress_fg=0

# Active selection
set color_win_sel_bg=5
set color_win_sel_fg=0
set color_win_sel_attr=bold
set color_win_cur_sel_bg=5
set color_win_cur_sel_fg=0
set color_win_cur_sel_attr=bold

# Inactive selection
set color_win_inactive_sel_bg=0
set color_win_inactive_sel_fg=8
set color_win_inactive_cur_sel_bg=0
set color_win_inactive_cur_sel_fg=3

# Album heading in the track view
set color_trackwin_album_bg=default
set color_trackwin_album_fg=5
set color_trackwin_album_attr=bold
