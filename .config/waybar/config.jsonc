// waybar config — top bar only: workspaces, time/date, cpu/mem, wifi, input method, battery,
// volume, brightness. Same spec as the ironbar bar it replaces. Verified against the real
// man pages (waybar-clock/cpu/memory/network/hyprland-workspaces/hyprland-language/battery/
// pulseaudio/backlight/power-profiles-daemon(5)), not guessed. Icon codepoints verified present
// in the installed JetBrainsMono Nerd Font Mono via `fc-query -f '%{charset}'` against its
// actual cmap and cross-checked against nerd-fonts' own glyphnames.json, not assumed from a
// generic Nerd Font cheatsheet.
{
    "layer": "top",
    "position": "top",
    "height": 36,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/kill", "custom/bluetooth", "custom/proxy", "power-profiles-daemon", "custom/fcitx5", "cpu", "memory", "backlight", "pulseaudio", "network", "battery"],

    "hyprland/workspaces": {
        "format": "{id}{windows}",
        "window-rewrite-default": "",
        "window-rewrite": {
            "kitty": "",
            "class<org.mozilla.firefox>": "",
            "class<org.kde.dolphin>": "",
            "[Ww]e[Cc]hat": "",
            "class<[Gg]imp>": "",
            "class<.*[Ww][Pp][Ss].*>": "󰈙",
            "class<[Ll]ibre[Oo]ffice.*>": "󰈙",
            "class<org.pulseaudio.pavucontrol>": "󰕾"
        },
        "on-click": "activate",
        "sort-by": "number"
    },

    "custom/kill": {
        "format": "󰅙",
        "on-click": "hyprctl kill",
        "tooltip-format": "Force-kill an unresponsive window (click to target)"
    },

    "custom/bluetooth": {
        "format": "",
        "on-click": "kcmshell6 kcm_bluetooth",
        "tooltip-format": "Bluetooth settings (bluedevil)"
    },

    "custom/proxy": {
        "exec": "echo '󰦛'",
        "exec-if": "pgrep -x mihomo-party",
        "interval": 5,
        "hide-empty-text": true,
        "on-click": "/opt/clash-party/mihomo-party",
        "tooltip-format": "Mihomo Party (proxy client)"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": {
            "performance": "",
            "balanced": "",
            "power-saver": ""
        },
        "tooltip-format": "Power profile: {profile}\\nClick to cycle"
    },

    "custom/fcitx5": {
        "exec": "~/.local/bin/waybar-fcitx5.sh",
        "interval": 1,
        "return-type": "json",
        "format": "󰌌  {}",
        "on-click": "fcitx5-remote -t",
        "tooltip": true
    },

    "clock": {
        "format": "󰥔  {:%a %d %b   %H:%M}"
    },

    "cpu": {
        "interval": 3,
        "format": "󰘚  {usage}%"
    },

    "memory": {
        "interval": 5,
        "format": "󰍛  {percentage}%"
    },

    "backlight": {
        "format": "󰃜  {percent}%"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁  muted",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "Volume: {volume}% (scroll to adjust, right-click to mute)"
    },

    "network": {
        "format-wifi": "󰖩  {essid}",
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰖪  disconnected",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "battery": {
        "format": "󰁹  {capacity}%",
        "format-charging": "󱐋  {capacity}%"
    }
}
