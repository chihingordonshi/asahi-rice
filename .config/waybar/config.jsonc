// waybar config — top bar only: workspaces, time/date, cpu/mem, wifi, input method, battery,
// volume, brightness. Same spec as the ironbar bar it replaces. Verified against the real
// man pages (waybar-clock/cpu/memory/network/hyprland-workspaces/battery/pulseaudio/backlight
// (5)), not guessed. Icon codepoints verified present in the installed JetBrainsMono Nerd Font
// Mono via `fc-query -f '%{charset}'` against its actual cmap and cross-checked against
// nerd-fonts' own glyphnames.json. Only Supplementary Private Use Area-A codepoints (U+F0000+)
// are used here -- the older single-codepoint Nerd Font range (U+E000-U+F8FF) was found to get
// silently dropped when this file is written by tooling, so it's avoided entirely.
//
// power-profiles-daemon's built-in waybar module wasn't rendering its {icon} format-icons
// lookup reliably in testing, so custom/power-profile (waybar-power-profile.sh) reads/cycles
// the profile directly over dbus instead.
{
    "layer": "top",
    "position": "top",
    "height": 36,

    "modules-left": ["custom/kill", "custom/proxy", "custom/fcitx5", "custom/power-profile", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "cpu", "memory", "custom/bluetooth", "backlight", "pulseaudio", "network", "battery"],

    "hyprland/workspaces": {
        "format": "{id} {windows}",
        "window-rewrite-default": "󰀻",
        "window-rewrite": {
            "kitty": "󰆍",
            "class<terminal>": "󰆍",
            "class<org.mozilla.firefox>": "󰈹",
            "class<[Gg]oogle-[Cc]hrome.*>": "󰊯",
            "class<org.kde.dolphin>": "󰉋",
            "[Ww]e[Cc]hat": "󰘑",
            "class<^mpv$>": "󰎁",
            "class<[Pp]inta>": "󰏘",
            "class<[Gg]imp>": "󰋩",
            "class<.*[Ww][Pp][Ss].*>": "󰈙",
            "class<[Ll]ibre[Oo]ffice.*>": "󰈙",
            "class<org.pulseaudio.pavucontrol>": "󰕾"
        },
        "sort-by": "number"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "custom/kill": {
        "format": "󰅙",
        "on-click": "hyprctl kill",
        "tooltip-format": "Force-kill an unresponsive window (click to target)"
    },

    "custom/bluetooth": {
        "exec": "~/.local/bin/waybar-bluetooth.sh",
        "interval": 5,
        "return-type": "json",
        "format": "{}",
        "on-click": "kcmshell6 kcm_bluetooth",
        "tooltip": true
    },

    "custom/proxy": {
        "exec": "echo '󰦛'",
        "exec-if": "pgrep -x mihomo-party",
        "interval": 5,
        "hide-empty-text": true,
        "on-click": "/opt/clash-party/mihomo-party",
        "tooltip-format": "Mihomo Party (proxy client)"
    },

    "custom/power-profile": {
        "exec": "~/.local/bin/waybar-power-profile.sh",
        "interval": 3,
        "return-type": "json",
        "format": "{}",
        "on-click": "~/.local/bin/waybar-power-profile-cycle.sh",
        "tooltip": true
    },

    "custom/fcitx5": {
        "exec": "~/.local/bin/waybar-fcitx5.sh",
        "interval": 1,
        "return-type": "json",
        "format": "󰌌  {}",
        "on-click": "fcitx5-remote -t",
        "tooltip": true
    },

    "clock": {
        "format": "󰥔  {:%a %d %b %H:%M}"
    },

    "cpu": {
        "interval": 3,
        "format": "󰘚  {usage}%"
    },

    "memory": {
        "interval": 5,
        "format": "󰍛  {percentage}%"
    },

    "backlight": {
        "format": "󰃜  {percent}%"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁  muted",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "Volume: {volume}% (scroll to adjust, right-click to mute)"
    },

    "network": {
        "format-wifi": "󰖩  {essid}",
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰖪  disconnected",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "battery": {
        "format": "󰁹  {capacity}%",
        "format-charging": "󱐋  {capacity}%"
    }
}
