// Keep the standard US layout and Caps Lock -> Super, but make both Option
// keys ordinary Escape keys (including while held, with no Alt modifier).
xkb_keymap {
    xkb_keycodes { include "evdev+aliases(qwerty)" };
    xkb_types { include "complete" };
    xkb_compatibility { include "complete" };
    xkb_symbols {
        include "pc+us+inet(evdev)+capslock(super)"
        name[Group1] = "English (US, Option as Escape)";
        replace key <LALT> { type[Group1] = "ONE_LEVEL", [ Escape ] };
        replace key <RALT> { type[Group1] = "ONE_LEVEL", [ Escape ] };
        modifier_map None { <LALT>, <RALT> };
    };
};
